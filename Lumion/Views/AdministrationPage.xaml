<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.AdministrationPage"
             x:DataType="vm:AdministrationViewModel">
    <ContentPage.Resources>
        <Style x:Key="Tuile4" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Bordure}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <c:EnTete Titre="Administration" Retour="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="14">
                <!-- Indicateurs -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource Tuile4}">
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource Tuile}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource ConfirmeeDoux}">
                                <c:Icone Nom="Eclair" Taille="15" Couleur="{StaticResource Confirmee}" />
                            </Border>
                            <Label Text="{Binding NbEnCours}" Style="{StaticResource ChiffreMoyen}" FontSize="24" />
                            <Label Text="délestages en cours" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tuile4}">
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource Tuile}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource DelestageDoux}">
                                <c:Icone Nom="Personnes" Taille="15" Couleur="{StaticResource Delestage}" />
                            </Border>
                            <Label Text="{Binding NbUtilisateurs}" Style="{StaticResource ChiffreMoyen}" FontSize="24" />
                            <Label Text="utilisateurs actifs" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Tuile4}">
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource Tuile}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource AccentDoux}">
                                <c:Icone Nom="Calendrier" Taille="15" Couleur="{StaticResource AccentTexte}" />
                            </Border>
                            <Label Text="{Binding NbProgrammes}" Style="{StaticResource ChiffreMoyen}" FontSize="24" />
                            <Label Text="délestages programmés" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tuile4}">
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource Tuile}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource NormalDoux}">
                                <c:Icone Nom="Carte" Taille="15" Couleur="{StaticResource Normal}" />
                            </Border>
                            <Label Text="{Binding NbQuartiers}" Style="{StaticResource ChiffreMoyen}" FontSize="24" />
                            <Label Text="quartiers activés" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <c:Choix Options="Quartiers|Utilisateurs|Délestages|Export" Selection="{Binding Onglet}" />
                </ScrollView>

                <!-- Quartiers (UC16) -->
                <Border Style="{StaticResource Carte}" Padding="16,6,16,14" IsVisible="{Binding OngletQuartiers}">
                    <VerticalStackLayout Spacing="4">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Quartiers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneQuartierAdmin">
                                    <Grid ColumnDefinitions="Auto,*,44" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="56">
                                        <Ellipse WidthRequest="9" HeightRequest="9" Fill="{Binding Couleur}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Quartier.Nom}" Style="{StaticResource TexteElement}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource TexteLegende}" />
                                        </VerticalStackLayout>
                                        <Grid Grid.Column="2" BackgroundColor="Transparent" SemanticProperties.Description="Actions sur le quartier">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ActionsQuartierCommand, Source={RelativeSource AncestorType={x:Type vm:AdministrationViewModel}}, x:DataType=vm:AdministrationViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <c:Icone Nom="Points" Taille="20" Couleur="{StaticResource Texte2}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="Ajouter un quartier" Style="{StaticResource BoutonSecondaire}" Command="{Binding AjouterQuartierCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Utilisateurs (UC17) -->
                <Border Style="{StaticResource Carte}" IsVisible="{Binding OngletUtilisateurs}">
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource Champ}" BackgroundColor="{StaticResource Surface2}" StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <c:Icone Nom="Recherche" Taille="18" Couleur="{StaticResource Texte2}" />
                                <Entry Grid.Column="1" Text="{Binding Recherche}" Placeholder="Nom ou numéro"
                                       SemanticProperties.Description="Rechercher un utilisateur" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Utilisateurs}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucun utilisateur ne correspond à la recherche." Style="{StaticResource TexteSecondaire}"
                                       Padding="0,12" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneUtilisateur">
                                    <Grid ColumnDefinitions="Auto,*,44" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="60">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{Binding Clair}">
                                            <Label Text="{Binding Initiales}" TextColor="{Binding Couleur}" FontFamily="JakartaBold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Utilisateur.NomAffichage}" Style="{StaticResource TexteElement}"
                                                   LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Role}" Style="{StaticResource TexteBadge}" TextColor="{Binding CouleurRole}" />
                                                <Label Text="{Binding Contact}" Style="{StaticResource TexteLegende}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Grid Grid.Column="2" BackgroundColor="Transparent" SemanticProperties.Description="Actions sur l'utilisateur">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ActionsUtilisateurCommand, Source={RelativeSource AncestorType={x:Type vm:AdministrationViewModel}}, x:DataType=vm:AdministrationViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <c:Icone Nom="Points" Taille="20" Couleur="{StaticResource Texte2}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Délestages (UC18) -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding OngletDelestages}">
                    <Border Style="{StaticResource BlocVedette}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource Accent}">
                                    <c:Icone Nom="Calendrier" Taille="18" Couleur="{StaticResource SurAccent}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="Annoncer un délestage" Style="{StaticResource TexteElement}" FontFamily="JakartaBold"
                                           TextColor="{StaticResource VedetteTexte}" />
                                    <Label Text="Les abonnés du quartier sont prévenus à l'avance" Style="{StaticResource TexteLegende}"
                                           TextColor="{StaticResource VedetteTexte2}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border Style="{StaticResource Champ}">
                                <Picker Title="Quartier concerné" ItemsSource="{Binding NomsQuartiers}" SelectedItem="{Binding QuartierDelestage}" />
                            </Border>
                            <Border Style="{StaticResource Champ}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <c:Icone Nom="Calendrier" Taille="18" Couleur="{StaticResource AccentTexte}" />
                                    <DatePicker Grid.Column="1" Date="{Binding DateDelestage}" MinimumDate="{Binding DateMin}"
                                                Format="dd/MM/yyyy" HorizontalOptions="Start" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource Champ}" Padding="14,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Début" Style="{StaticResource TexteLegende}" />
                                        <TimePicker Time="{Binding HeureDebut}" Format="HH:mm" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Champ}" Padding="14,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Fin" Style="{StaticResource TexteLegende}" />
                                        <TimePicker Time="{Binding HeureFin}" Format="HH:mm" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Champ}">
                                <Entry Text="{Binding Source}" Placeholder="Source (ex. communiqué du fournisseur)" MaxLength="80" />
                            </Border>
                            <Button Text="Publier et notifier les abonnés" Command="{Binding PublierCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Annonces" Style="{StaticResource Surtitre}" />
                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Annonces}" Spacing="14">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucune annonce de délestage." Style="{StaticResource TexteSecondaire}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneAnnonce">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Titre}" Style="{StaticResource TexteElement}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource TexteLegende}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Style="{StaticResource Pastille}" BackgroundColor="{Binding Clair}" VerticalOptions="Start">
                                            <Label Text="{Binding Statut}" Style="{StaticResource TexteBadge}" TextColor="{Binding Couleur}" />
                                        </Border>
                                        <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Annuler ce délestage"
                                                Style="{StaticResource BoutonLien}" TextColor="{StaticResource Confirmee}"
                                                HorizontalOptions="Start" IsVisible="{Binding Annulable}" Padding="0,4"
                                                Command="{Binding AnnulerAnnonceCommand, Source={RelativeSource AncestorType={x:Type vm:AdministrationViewModel}}, x:DataType=vm:AdministrationViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Export et démonstration (UC19) -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding OngletExport}">
                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Exporter les statistiques" Style="{StaticResource TitreSection}" />
                            <Label Style="{StaticResource TexteSecondaire}"
                                   Text="Fichier CSV : une ligne par coupure, puis un récapitulatif mensuel par quartier." />
                            <Border Style="{StaticResource Champ}" BackgroundColor="{StaticResource Surface2}" StrokeThickness="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <c:Icone Nom="Calendrier" Taille="18" Couleur="{StaticResource AccentTexte}" />
                                    <Picker Grid.Column="1" Title="Mois" ItemsSource="{Binding Mois}" SelectedItem="{Binding MoisExport}" />
                                </Grid>
                            </Border>
                            <Button Text="Générer et partager le CSV" Command="{Binding ExporterCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Démonstration" Style="{StaticResource Surtitre}" />
                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,56" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Vérification GPS stricte" Style="{StaticResource TexteElement}" />
                                    <Label Style="{StaticResource TexteLegende}"
                                           Text="Un signalement fait hors du quartier choisi ne compte qu'après validation (RG08)." />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding GpsStrict}" HorizontalOptions="End" VerticalOptions="Center"
                                        SemanticProperties.Description="Vérification GPS stricte" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />
                            <Button Text="Simuler 2 voisins" Style="{StaticResource BoutonSecondaire}" Command="{Binding SimulerVoisinsCommand}" />
                            <Button Text="Réinitialiser la démo" Style="{StaticResource BoutonDanger}" Command="{Binding ReinitialiserCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
