<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:v="clr-namespace:Lumion.Views"
             x:Class="Lumion.Views.NotificationsPage">
    <Grid RowDefinitions="Auto,*">
        <c:EnTete Titre="Notifications" Retour="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="10">
                <!-- Aucune notification -->
                <VerticalStackLayout x:Name="Vide" Padding="12,48,12,0" Spacing="12" IsVisible="False">
                    <Grid WidthRequest="150" HeightRequest="150" HorizontalOptions="Center">
                        <Ellipse Fill="{StaticResource AccentHalo2}" />
                        <Ellipse Fill="{StaticResource AccentHalo}" Margin="22" />
                        <Ellipse Fill="{StaticResource AccentDoux}" Margin="42" />
                        <c:Icone Nom="Cloche" Taille="36" Couleur="{StaticResource AccentTexte}" />
                    </Grid>
                    <Label Text="Aucune notification" Style="{StaticResource TitreSection}" HorizontalTextAlignment="Center" />
                    <Label Text="Vous serez prévenu au début et à la fin d'une coupure dans les quartiers que vous suivez."
                           Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Notifications par jour -->
                <VerticalStackLayout x:Name="Groupes" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="v:GroupeNotifications">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Titre}" Style="{StaticResource Surtitre}" Margin="0,6,0,0" />
                                <Border Style="{StaticResource Carte}" Padding="14,2">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="v:LigneNotification">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,12"
                                                      BackgroundColor="Transparent">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="Ouvrir" CommandParameter="{Binding QuartierId}" />
                                                    </Grid.GestureRecognizers>
                                                    <Border Style="{StaticResource Tuile}" BackgroundColor="{Binding Clair}" VerticalOptions="Start">
                                                        <c:Icone Nom="{Binding Icone}" Taille="18" Couleur="{Binding Couleur}" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                        <Label Text="{Binding Titre}" Style="{StaticResource TexteElement}" FontFamily="{Binding Police}" />
                                                        <Label Text="{Binding Message}" Style="{StaticResource TexteSecondaire}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                                                        <Label Text="{Binding Heure}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource Texte3}" />
                                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Accent}" HorizontalOptions="End"
                                                                 IsVisible="{Binding NonLue}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
