<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:v="clr-namespace:Lumion.Views"
             x:Class="Lumion.Views.NotificationsPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="48,*" Padding="12,8,16,8" BackgroundColor="{StaticResource Blanc}">
            <Grid BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="Retour">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Retour" />
                </Grid.GestureRecognizers>
                <c:Icone Nom="ChevronGauche" />
            </Grid>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Notifications" Style="{StaticResource TitrePage}" FontSize="22" />
                <Label Text="Alertes de vos quartiers abonnés" Style="{StaticResource SousTitrePage}" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" x:Name="Liste" SelectionMode="Single" SelectionChanged="Ouvrir">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,64,32,0" Spacing="8">
                    <c:Icone Nom="Cloche" Taille="44" Couleur="{StaticResource GrisClair}" />
                    <Label Text="Aucune notification" Style="{StaticResource TitreElement}" HorizontalTextAlignment="Center" />
                    <Label Text="Vous serez prévenu au début et à la fin d'une coupure dans vos quartiers abonnés."
                           Style="{StaticResource Discret}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="v:LigneNotification">
                    <Grid Padding="16,6">
                        <Border Style="{StaticResource Carte}" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Style="{StaticResource Rond}" BackgroundColor="{Binding Couleur}" VerticalOptions="Start">
                                    <c:Icone Nom="{Binding Icone}" Couleur="{StaticResource Blanc}" Taille="20" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Titre}" Style="{StaticResource TitreElement}" />
                                    <Label Text="{Binding Message}" FontSize="13" />
                                    <Label Text="{Binding Date}" Style="{StaticResource Discret}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <c:BarreOnglets Grid.Row="2" Actif="accueil" />
    </Grid>
</ContentPage>
