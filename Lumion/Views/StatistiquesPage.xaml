<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.StatistiquesPage"
             x:DataType="vm:StatistiquesViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:EnTete Titre="Statistiques" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="14">

                <!-- Sélecteurs : quartier et mois, en puces qui ouvrent une liste -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Bordure}"
                            StrokeThickness="1" Padding="12,10" SemanticProperties.Description="Choisir le quartier">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChoisirQuartierCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <c:Icone Nom="Epingle" Taille="15" Couleur="{StaticResource AccentTexte}" />
                            <Label Grid.Column="1" Text="{Binding QuartierChoisi}" Style="{StaticResource TexteBadge}" FontSize="13"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <c:Icone Grid.Column="2" Nom="ChevronBas" Taille="13" Couleur="{StaticResource Texte2}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Bordure}"
                            StrokeThickness="1" Padding="12,10" SemanticProperties.Description="Choisir le mois" Grid.Column="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChoisirMoisCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <c:Icone Nom="Calendrier" Taille="15" Couleur="{StaticResource AccentTexte}" />
                            <Label Grid.Column="1" Text="{Binding MoisChoisi}" Style="{StaticResource TexteBadge}" FontSize="13"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <c:Icone Grid.Column="2" Nom="ChevronBas" Taille="13" Couleur="{StaticResource Texte2}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- État vide -->
                <Border Style="{StaticResource Carte}" Padding="24" IsVisible="{Binding AucuneDonnee}">
                    <VerticalStackLayout Spacing="8">
                        <c:Icone Nom="Stats" Taille="36" Couleur="{StaticResource Texte3}" />
                        <Label Text="Pas encore de données pour ce mois" Style="{StaticResource TexteElement}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Aucune coupure terminée n'a été enregistrée pour ce quartier sur ce mois."
                               Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Chiffre vedette -->
                <Border Style="{StaticResource BlocVedette}" Padding="20" IsVisible="{Binding AvecDonnees}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding HeroTitre}" Style="{StaticResource Surtitre}" TextColor="{StaticResource VedetteTexte2}" />
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding HeroValeur}" Style="{StaticResource ChiffreGrand}" FontSize="52"
                                   TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding HeroUnite}" Style="{StaticResource TitreSection}" TextColor="{StaticResource VedetteTexte}"
                                   VerticalOptions="End" Margin="0,0,0,10" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource Pastille}" BackgroundColor="{Binding DeltaCouleur}" Padding="6,3,9,3">
                                <HorizontalStackLayout Spacing="3">
                                    <c:Icone Nom="{Binding DeltaIcone}" Taille="12" Couleur="{StaticResource Blanc}" />
                                    <Label Text="{Binding Delta}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource Blanc}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="{Binding ComparaisonMois}" Style="{StaticResource TexteLegende}"
                                   TextColor="{StaticResource VedetteTexte2}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource VedetteVoile}" HorizontalOptions="Start"
                                IsVisible="{Binding Provisoire}" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <c:Icone Nom="Info" Taille="13" Couleur="{StaticResource Accent}" />
                                <Label Grid.Column="1" Text="Chiffres provisoires : le mois est en cours" Style="{StaticResource TexteBadge}"
                                       LineBreakMode="WordWrap" TextColor="{StaticResource VedetteTexte}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Trois indicateurs -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding AvecDonnees}">
                    <c:CarteIndicateur Indicateur="{Binding Nombre}" />
                    <c:CarteIndicateur Grid.Column="1" Indicateur="{Binding DureeMoyenne}" />
                    <c:CarteIndicateur Grid.Column="2" Indicateur="{Binding PlusLongue}" />
                </Grid>

                <!-- Heures sans courant par mois : une seule mesure, un seul axe -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Heures sans courant" Style="{StaticResource TitreSection}" />
                            <Label Text="12 derniers mois · le mois choisi en ambre" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                        <GraphicsView x:Name="Evolution" HeightRequest="180"
                                      SemanticProperties.Description="Heures sans courant par mois sur 12 mois" />
                    </VerticalStackLayout>
                </Border>

                <!-- Répartition horaire -->
                <Border Style="{StaticResource Carte}" IsVisible="{Binding AvecDonnees}">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Quand ça coupe" Style="{StaticResource TitreSection}" />
                            <Label Text="Nombre de coupures par tranche de 3 heures" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                        <GraphicsView x:Name="Horaire" HeightRequest="130"
                                      SemanticProperties.Description="Répartition des coupures par heure de la journée" />
                        <Border Style="{StaticResource Pastille}" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AccentDoux}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <c:Icone Nom="Horloge" Taille="16" Couleur="{StaticResource AccentTexte}" />
                                <Label Grid.Column="1" Text="{Binding Pic}" Style="{StaticResource TexteLegende}"
                                       TextColor="{StaticResource Texte}" FontFamily="JakartaSemiBold" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Classement des quartiers -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Quartiers les plus touchés" Style="{StaticResource TitreSection}" />
                            <Label Grid.Column="1" Text="{Binding TitreClassement}" Style="{StaticResource TexteLegende}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Classement}" Spacing="14">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucune coupure terminée ce mois-ci." Style="{StaticResource TexteSecondaire}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RangQuartier">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Rang}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource Texte3}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Libelle}" FontFamily="{Binding Police}" FontSize="14" />
                                            <Label Grid.Column="2" Text="{Binding Valeur}" FontFamily="JakartaBold" FontSize="14" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Part}" ProgressColor="{Binding Couleur}" HeightRequest="6" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{Binding LibelleClassement}" Style="{StaticResource BoutonLien}" HorizontalOptions="Start"
                                Command="{Binding BasculerClassementCommand}" IsVisible="{Binding ClassementLong}" Padding="0,4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Comparaison de deux quartiers -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Comparer deux quartiers" Style="{StaticResource TitreSection}" />
                        <Border Style="{StaticResource Champ}" BackgroundColor="{StaticResource Surface2}" StrokeThickness="0">
                            <Picker Title="Comparer avec" ItemsSource="{Binding Comparaisons}"
                                    SelectedItem="{Binding ComparaisonChoisie}"
                                    SemanticProperties.Description="Quartier à comparer" />
                        </Border>
                        <Grid ColumnDefinitions="*,*,*" IsVisible="{Binding ComparaisonVisible}">
                            <Label Grid.Column="1" Text="{Binding EnTeteA}" Style="{StaticResource TexteElement}" FontSize="13" />
                            <Label Grid.Column="2" Text="{Binding EnTeteB}" Style="{StaticResource TexteElement}" FontSize="13" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comparaison}" Spacing="8"
                                             IsVisible="{Binding ComparaisonVisible}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneComparaison">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <Label Text="{Binding Libelle}" Style="{StaticResource TexteSecondaire}" />
                                        <Label Grid.Column="1" Text="{Binding A}" FontSize="14" />
                                        <Label Grid.Column="2" Text="{Binding B}" FontSize="14" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <c:BarreOnglets Grid.Row="2" Actif="statistiques" />
    </Grid>
</ContentPage>
