<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.CoupureDetailPage"
             x:DataType="vm:CoupureDetailViewModel">
    <Grid RowDefinitions="Auto,*">
        <c:EnTete Titre="Détail de la coupure" Retour="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="14">
                <!-- Synthèse -->
                <Border Style="{StaticResource BlocVedette}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Quartier}" Style="{StaticResource Surtitre}" TextColor="{StaticResource VedetteTexte2}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Pastille}" BackgroundColor="{StaticResource VedetteVoile}"
                                    Padding="8,5,10,5">
                                <HorizontalStackLayout Spacing="6">
                                    <c:Icone Nom="{Binding Icone}" Taille="12" Couleur="{Binding Couleur}" />
                                    <Label Text="{Binding Statut}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource VedetteTexte}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Duree}" Style="{StaticResource ChiffreGrand}" TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding MentionDuree}" Style="{StaticResource TexteLegende}" TextColor="{StaticResource VedetteTexte2}" />
                        </VerticalStackLayout>
                        <!-- Frise de la journée -->
                        <VerticalStackLayout Spacing="6">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource VedetteTrait}"
                                    HeightRequest="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Avant}" />
                                        <ColumnDefinition Width="{Binding Pendant}" />
                                        <ColumnDefinition Width="{Binding Apres}" />
                                    </Grid.ColumnDefinitions>
                                    <BoxView Grid.Column="1" Color="{StaticResource Accent}" CornerRadius="4" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Text="00:00" Style="{StaticResource TexteBadge}" TextColor="{StaticResource VedetteTexte2}" />
                                <Label Grid.Column="1" Style="{StaticResource TexteBadge}" TextColor="{StaticResource VedetteTexte}"
                                       HorizontalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding HeureDebut}" />
                                            <Span Text="  →  " />
                                            <Span Text="{Binding HeureFin}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Column="2" Text="24:00" Style="{StaticResource TexteBadge}" TextColor="{StaticResource VedetteTexte2}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Repères -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Carte}" Padding="12" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding NbSignalements}" Style="{StaticResource ChiffreMoyen}" />
                            <Label Text="signalements" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Carte}" Padding="12" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding HeureDebut}" Style="{StaticResource ChiffreMoyen}" />
                            <Label Text="{Binding Debut}" Style="{StaticResource TexteLegende}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="12" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding HeureFin}" Style="{StaticResource ChiffreMoyen}" />
                            <Label Text="{Binding Fin}" Style="{StaticResource TexteLegende}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Chronologie anonymisée (RG14) -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Chronologie" Style="{StaticResource TitreSection}" />
                            <Label Text="{Binding MentionAnonymat}" Style="{StaticResource TexteLegende}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Chronologie}">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucun signalement détaillé pour cette coupure." Style="{StaticResource TexteSecondaire}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneChronologie">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Rail : point de couleur et trait vers l'évènement suivant -->
                                        <Grid RowDefinitions="Auto,*" WidthRequest="12">
                                            <Ellipse WidthRequest="12" HeightRequest="12" Fill="{Binding Couleur}" Margin="0,4,0,0" />
                                            <BoxView Grid.Row="1" WidthRequest="2" Color="{StaticResource Bordure}" HorizontalOptions="Center"
                                                     MinimumHeightRequest="20" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,0,0,14">
                                            <Label Text="{Binding Titre}" Style="{StaticResource TexteElement}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource TexteLegende}" />
                                            <Label Text="{Binding Commentaire}" Style="{StaticResource TexteSecondaire}" FontAttributes="Italic"
                                                   IsVisible="{Binding ACommentaire}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Heure}" Style="{StaticResource TexteBadge}"
                                               TextColor="{StaticResource Texte3}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
