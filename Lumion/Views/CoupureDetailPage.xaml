<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.CoupureDetailPage"
             x:DataType="vm:CoupureDetailViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="48,*" Padding="12,8,16,8" BackgroundColor="{StaticResource Blanc}">
            <Grid BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="Retour">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Retour" />
                </Grid.GestureRecognizers>
                <c:Icone Nom="ChevronGauche" />
            </Grid>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Détail de la coupure" Style="{StaticResource TitrePage}" FontSize="22" />
                <Label Text="{Binding Quartier}" Style="{StaticResource SousTitrePage}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="16" BackgroundColor="{Binding Clair}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Rond}" BackgroundColor="{Binding Couleur}">
                            <c:Icone Nom="{Binding Icone}" Couleur="{StaticResource Blanc}" Taille="22" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Statut}" TextColor="{Binding Couleur}" FontFamily="OpenSansSemibold" FontSize="18" />
                            <Label Text="{Binding Signalements}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Début" Style="{StaticResource Discret}" />
                                <Label Text="{Binding Debut}" Style="{StaticResource TitreElement}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Fin" Style="{StaticResource Discret}" />
                                <Label Text="{Binding Fin}" Style="{StaticResource TitreElement}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Bordure}" />
                        <VerticalStackLayout>
                            <Label Text="Durée" Style="{StaticResource Discret}" />
                            <Label Text="{Binding Duree}" Style="{StaticResource Chiffre}" FontSize="28" />
                            <Label Text="{Binding MentionDuree}" Style="{StaticResource Discret}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Chronologie des signalements" Style="{StaticResource TitreSection}" />
                            <Label Text="{Binding MentionAnonymat}" Style="{StaticResource Discret}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Chronologie}" Spacing="14">
                            <BindableLayout.EmptyView>
                                <Label Text="Aucun signalement détaillé pour cette coupure." Style="{StaticResource Discret}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneChronologie">
                                    <Grid ColumnDefinitions="48,Auto,*" ColumnSpacing="10">
                                        <Label Text="{Binding Heure}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Encre}" />
                                        <Border Grid.Column="1" Style="{StaticResource Rond}" WidthRequest="26" HeightRequest="26"
                                                BackgroundColor="{Binding Couleur}" VerticalOptions="Start">
                                            <c:Icone Nom="{Binding Icone}" Couleur="{StaticResource Blanc}" Taille="14" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="{Binding Titre}" Style="{StaticResource TitreElement}" FontSize="14" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="12" />
                                            <Label Text="{Binding Commentaire}" FontSize="13" FontAttributes="Italic"
                                                   IsVisible="{Binding ACommentaire}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
