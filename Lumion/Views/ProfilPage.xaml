<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.ProfilPage"
             x:DataType="vm:ProfilViewModel">
    <ContentPage.Resources>
        <!-- Ligne de réglage : pastille d'icône, texte, puis valeur ou interrupteur -->
        <Style x:Key="Ligne" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="MinimumHeightRequest" Value="56" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <c:EnTete Titre="Profil" IconeAction="Crayon" DescriptionAction="Modifier le profil" Commande="{Binding ModifierCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="12">

                <!-- Visiteur -->
                <Border Style="{StaticResource Carte}" Padding="24" IsVisible="{Binding Session.EstVisiteur}">
                    <VerticalStackLayout Spacing="12">
                        <c:Logo HorizontalOptions="Center" />
                        <Label Text="Vous consultez Lumion sans compte" Style="{StaticResource TexteElement}"
                               HorizontalTextAlignment="Center" />
                        <Label Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center"
                               Text="Créez un compte pour signaler une coupure, confirmer celles de vos voisins et être prévenu dans votre quartier." />
                        <Button Text="Se connecter" Command="{Binding SeConnecterCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding Session.EstConnecte}">
                    <!-- Identité -->
                    <Border Style="{StaticResource BlocVedette}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="60" HeightRequest="60" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{StaticResource Accent}">
                                    <Label Text="{Binding Initiales}" FontFamily="JakartaExtraBold" FontSize="20"
                                           TextColor="{StaticResource SurAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Nom}" Style="{StaticResource TitreSection}" FontFamily="JakartaExtraBold"
                                           TextColor="{StaticResource VedetteTexte}" />
                                    <Label Text="{Binding Telephone}" Style="{StaticResource TexteLegende}" TextColor="{StaticResource VedetteTexte2}" />
                                    <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource VedetteVoile}"
                                            HorizontalOptions="Start" Padding="8,4,10,4">
                                        <HorizontalStackLayout Spacing="6">
                                            <c:Icone Nom="Bouclier" Taille="12" Couleur="{StaticResource Accent}" />
                                            <Label Text="{Binding Role}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource VedetteTexte}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="6">
                                <c:Icone Nom="Epingle" Taille="14" Couleur="{StaticResource VedetteTexte2}" />
                                <Label Text="{Binding Lieu}" Style="{StaticResource TexteLegende}" TextColor="{StaticResource VedetteTexte2}" />
                            </HorizontalStackLayout>
                            <Border Style="{StaticResource Pastille}" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ConfirmeeDoux}"
                                    Padding="12,10" IsVisible="{Binding Suspendu}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <c:Icone Nom="Alerte" Taille="18" Couleur="{StaticResource Confirmee}" />
                                    <Label Grid.Column="1" Text="{Binding MentionSuspension}" Style="{StaticResource TexteLegende}"
                                           TextColor="{StaticResource Confirmee}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Quartiers suivis (UC12) -->
                    <Label Text="Quartiers suivis" Style="{StaticResource Surtitre}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Carte}" Padding="16,2">
                        <VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Abonnements}">
                                <BindableLayout.EmptyView>
                                    <Label Text="Vous ne suivez aucun quartier pour l'instant." Style="{StaticResource TexteSecondaire}"
                                           Padding="0,14" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PuceAbonnement">
                                        <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,Auto">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding ReglerAbonnementCommand, Source={RelativeSource AncestorType={x:Type vm:ProfilViewModel}}, x:DataType=vm:ProfilViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Border Style="{StaticResource Tuile}" BackgroundColor="{StaticResource AccentDoux}">
                                                <c:Icone Nom="Cloche" Taille="16" Couleur="{StaticResource AccentTexte}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Nom}" Style="{StaticResource TexteElement}" />
                                                <Label Text="{Binding Alertes}" Style="{StaticResource TexteLegende}" />
                                            </VerticalStackLayout>
                                            <c:Icone Grid.Column="2" Nom="ChevronDroite" Taille="16" Couleur="{StaticResource Texte3}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Separateur}" />
                            <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*" IsEnabled="{Binding PeutAjouter}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AjouterAbonnementCommand}" />
                                </Grid.GestureRecognizers>
                                <c:Icone Nom="Plus" Taille="18" Couleur="{StaticResource AccentTexte}" />
                                <Label Grid.Column="1" Text="Suivre un autre quartier" Style="{StaticResource TexteElement}"
                                       TextColor="{StaticResource AccentTexte}" FontFamily="JakartaBold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Préférences -->
                <Label Text="Préférences" Style="{StaticResource Surtitre}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Carte}" Padding="16,2">
                    <VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding Session.EstConnecte}">
                            <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,56">
                                <Border Style="{StaticResource Tuile}">
                                    <c:Icone Nom="Cloche" Taille="16" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Notifications" Style="{StaticResource TexteElement}" />
                                    <Label Text="Coupures, retours et délestages" Style="{StaticResource TexteLegende}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding NotificationsActives}" HorizontalOptions="End"
                                        VerticalOptions="Center" SemanticProperties.Description="Activer les notifications" />
                            </Grid>
                            <BoxView Style="{StaticResource Separateur}" />
                            <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,56">
                                <Border Style="{StaticResource Tuile}">
                                    <c:Icone Nom="Lune" Taille="16" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Heures silencieuses" Style="{StaticResource TexteElement}" />
                                    <Label Text="Pas d'alerte sonore pendant cette période" Style="{StaticResource TexteLegende}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding SilenceActif}" HorizontalOptions="End"
                                        VerticalOptions="Center" SemanticProperties.Description="Activer les heures silencieuses" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8" Padding="48,0,0,12" IsVisible="{Binding SilenceActif}">
                                <Label Text="De" Style="{StaticResource TexteSecondaire}" VerticalOptions="Center" />
                                <TimePicker Time="{Binding SilenceDebut}" Format="HH:mm" SemanticProperties.Description="Début des heures silencieuses" />
                                <Label Text="à" Style="{StaticResource TexteSecondaire}" VerticalOptions="Center" />
                                <TimePicker Time="{Binding SilenceFin}" Format="HH:mm" SemanticProperties.Description="Fin des heures silencieuses" />
                            </HorizontalStackLayout>
                            <BoxView Style="{StaticResource Separateur}" />
                        </VerticalStackLayout>

                        <!-- Apparence : le sombre économise la batterie des écrans OLED -->
                        <VerticalStackLayout Spacing="10" Padding="0,12,0,14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Style="{StaticResource Tuile}">
                                    <c:Icone Nom="Lune" Taille="16" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Apparence" Style="{StaticResource TexteElement}" />
                                    <Label Text="Le thème sombre économise la batterie" Style="{StaticResource TexteLegende}" />
                                </VerticalStackLayout>
                            </Grid>
                            <c:Choix Segment="True" Options="Clair|Sombre|Auto" Valeurs="Clair|Sombre|Auto" Selection="{Binding Apparence}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Separateur}" />
                        <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LangueCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Tuile}">
                                <c:Icone Nom="Globe" Taille="16" />
                            </Border>
                            <Label Grid.Column="1" Text="Langue" Style="{StaticResource TexteElement}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="Français" Style="{StaticResource TexteLegende}" VerticalOptions="Center" />
                            <c:Icone Grid.Column="3" Nom="ChevronDroite" Taille="16" Couleur="{StaticResource Texte3}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Connexion : serveur et espaces réservés -->
                <Label Text="Connexion" Style="{StaticResource Surtitre}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Carte}" Padding="16,2">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChoisirServeurCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Tuile}">
                                <c:Icone Nom="Serveur" Taille="16" Couleur="{Binding CouleurServeur}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding EtatServeur}" Style="{StaticResource TexteElement}" />
                                <Label Text="{Binding Serveur}" Style="{StaticResource TexteLegende}" LineBreakMode="MiddleTruncation" />
                            </VerticalStackLayout>
                            <c:Icone Grid.Column="2" Nom="ChevronDroite" Taille="16" Couleur="{StaticResource Texte3}" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding Session.EstModerateur}">
                            <BoxView Style="{StaticResource Separateur}" />
                            <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ModerationCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource Tuile}">
                                    <c:Icone Nom="Bouclier" Taille="16" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Espace modération" Style="{StaticResource TexteElement}" />
                                    <Label Text="Vérifier et valider les signalements" Style="{StaticResource TexteLegende}" />
                                </VerticalStackLayout>
                                <c:Icone Grid.Column="2" Nom="ChevronDroite" Taille="16" Couleur="{StaticResource Texte3}" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding Session.EstAdmin}">
                            <BoxView Style="{StaticResource Separateur}" />
                            <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AdministrationCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource Tuile}">
                                    <c:Icone Nom="Reglages" Taille="16" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Administration" Style="{StaticResource TexteElement}" />
                                    <Label Text="Quartiers, utilisateurs et délestages" Style="{StaticResource TexteLegende}" />
                                </VerticalStackLayout>
                                <c:Icone Grid.Column="2" Nom="ChevronDroite" Taille="16" Couleur="{StaticResource Texte3}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Compte -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding Session.EstConnecte}">
                    <Label Text="Compte" Style="{StaticResource Surtitre}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Carte}" Padding="16,2">
                        <Grid Style="{StaticResource Ligne}" ColumnDefinitions="Auto,*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeconnecterCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Tuile}" BackgroundColor="{StaticResource ConfirmeeDoux}">
                                <c:Icone Nom="Sortie" Taille="16" Couleur="{StaticResource Confirmee}" />
                            </Border>
                            <Label Grid.Column="1" Text="Se déconnecter" Style="{StaticResource TexteElement}" FontFamily="JakartaBold"
                                   TextColor="{StaticResource Confirmee}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Button Text="Supprimer mon compte" Style="{StaticResource BoutonLien}" TextColor="{StaticResource Texte3}"
                            FontSize="13" Command="{Binding SupprimerCompteCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <c:BarreOnglets Grid.Row="2" Actif="profil" />
    </Grid>
</ContentPage>
