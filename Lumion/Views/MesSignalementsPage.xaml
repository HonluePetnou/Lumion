<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.MesSignalementsPage"
             x:DataType="vm:MesSignalementsViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <c:EnTete Titre="Activité" />
        <c:Choix Grid.Row="1" Segment="True" Options="Historique|Mes signalements" Valeurs="historique|signalements"
                 Selection="signalements" Change="OngletChange" Margin="20,4,20,10" />

        <!-- Visiteur : le suivi personnel demande un compte -->
        <VerticalStackLayout Grid.Row="2" Padding="32,40,32,0" Spacing="14" IsVisible="{Binding Session.EstVisiteur}">
            <Grid WidthRequest="150" HeightRequest="150" HorizontalOptions="Center">
                <Ellipse Fill="{StaticResource AccentHalo2}" />
                <Ellipse Fill="{StaticResource AccentHalo}" Margin="22" />
                <Ellipse Fill="{StaticResource AccentDoux}" Margin="42" />
                <c:Icone Nom="Document" Taille="36" Couleur="{StaticResource AccentTexte}" />
            </Grid>
            <Label Text="Connectez-vous pour suivre vos signalements" Style="{StaticResource TitreSection}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Sans compte, la carte, l'historique et les statistiques restent consultables."
                   Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center" />
            <Button Text="Se connecter" Command="{Binding SeConnecterCommand}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Signalements}" IsVisible="{Binding Session.EstConnecte}">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,0,20,10" Spacing="12">
                    <!-- Fiabilité -->
                    <Border Style="{StaticResource Carte}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <c:Anneau Valeur="{Binding Fiabilite}" Couleur="{Binding FiabiliteCouleur}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding FiabiliteTitre}" Style="{StaticResource TexteElement}" FontFamily="JakartaExtraBold" />
                                <Label Text="{Binding FiabiliteDetail}" Style="{StaticResource TexteLegende}" />
                                <Label Text="Vos signalements fiables comptent davantage pour confirmer une coupure."
                                       Style="{StaticResource TexteLegende}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Signalements saisis hors ligne -->
                    <Border Style="{StaticResource Carte}" BackgroundColor="{StaticResource AccentDoux}" StrokeThickness="0"
                            Padding="14,12" IsVisible="{Binding EnAttenteVisible}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <c:Icone Nom="HorsLigne" Taille="20" Couleur="{StaticResource AccentTexte}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding MentionEnAttente}" Style="{StaticResource TexteElement}" FontFamily="JakartaBold" />
                                <Label Text="Ils partiront automatiquement au retour du réseau." Style="{StaticResource TexteLegende}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <c:Choix Options="Tous|En cours|Validés|Rejetés|Annulés" Selection="{Binding Filtre}" />
                    </ScrollView>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,24,32,0" Spacing="12">
                    <Grid WidthRequest="150" HeightRequest="150" HorizontalOptions="Center">
                        <Ellipse Fill="{StaticResource AccentHalo2}" />
                        <Ellipse Fill="{StaticResource AccentHalo}" Margin="22" />
                        <Ellipse Fill="{StaticResource AccentDoux}" Margin="42" />
                        <c:Icone Nom="Document" Taille="36" Couleur="{StaticResource AccentTexte}" />
                    </Grid>
                    <Label Text="{Binding TitreVide}" Style="{StaticResource TitreSection}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding TexteVide}" Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LigneSignalement">
                    <Grid Padding="20,4">
                        <Border Style="{StaticResource Carte}" Padding="14,12" StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OuvrirCommand, Source={RelativeSource AncestorType={x:Type vm:MesSignalementsViewModel}}, x:DataType=vm:MesSignalementsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource Tuile}" BackgroundColor="{Binding ClairStatut}" VerticalOptions="Start">
                                    <c:Icone Nom="{Binding IconeStatut}" Taille="16" Couleur="{Binding CouleurStatut}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Quartier}" Style="{StaticResource TexteElement}" FontFamily="JakartaBold" />
                                        <Label Text="{Binding Statut}" Style="{StaticResource TexteBadge}" TextColor="{Binding CouleurStatut}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Sous}" Style="{StaticResource TexteLegende}" />
                                    <Label Text="{Binding Commentaire}" Style="{StaticResource TexteLegende}" FontAttributes="Italic"
                                           IsVisible="{Binding ACommentaire}" />
                                    <Label Text="{Binding Reste}" Style="{StaticResource TexteBadge}" TextColor="{StaticResource Confirmee}"
                                           IsVisible="{Binding Annulable}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource Pastille}" BackgroundColor="Transparent" StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource Bordure}" StrokeThickness="1" Padding="10,7" VerticalOptions="Start"
                                        IsVisible="{Binding Annulable}" SemanticProperties.Description="Annuler ce signalement">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding AnnulerCommand, Source={RelativeSource AncestorType={x:Type vm:MesSignalementsViewModel}}, x:DataType=vm:MesSignalementsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Annuler" Style="{StaticResource TexteBadge}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <c:BarreOnglets Grid.Row="3" Actif="activite" />
    </Grid>
</ContentPage>
