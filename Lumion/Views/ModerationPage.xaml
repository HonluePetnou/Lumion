<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.ModerationPage"
             x:DataType="vm:ModerationViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <c:EnTete Titre="Modération" Retour="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,4,20,6" Spacing="8">
            <c:Choix Segment="True" Options="{Binding Onglets}" Valeurs="traiter|suspects" Selection="{Binding Onglet}" />
            <Grid HorizontalOptions="Start" BackgroundColor="Transparent" Padding="0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding InverserTriCommand}" />
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <c:Icone Nom="Filtre" Taille="14" Couleur="{StaticResource Texte2}" />
                    <Label Text="{Binding LibelleTri}" Style="{StaticResource TexteLegende}" FontFamily="JakartaSemiBold" />
                    <c:Icone Nom="ChevronBas" Taille="12" Couleur="{StaticResource Texte2}" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Cartes}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,56,32,0" Spacing="8">
                    <c:Icone Nom="Check" Taille="40" Couleur="{StaticResource Normal}" />
                    <Label Text="Rien à traiter" Style="{StaticResource TexteElement}" HorizontalTextAlignment="Center" />
                    <Label Text="La file de modération est vide pour cette catégorie." Style="{StaticResource TexteSecondaire}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CarteModeration">
                    <Grid Padding="20,5">
                        <Border Style="{StaticResource Carte}">
                            <VerticalStackLayout Spacing="12">
                                <!-- En-tête : quartier, ancienneté, statut -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding DeplierCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Quartier}" Style="{StaticResource TitreSection}" FontFamily="JakartaExtraBold" />
                                        <Label Style="{StaticResource TexteLegende}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Date}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Signalements}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource Pastille}" BackgroundColor="{Binding Clair}"
                                            VerticalOptions="Start">
                                        <HorizontalStackLayout Spacing="6">
                                            <Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding Couleur}" VerticalOptions="Center" />
                                            <Label Text="{Binding StatutCourt}" Style="{StaticResource TexteBadge}" TextColor="{Binding Couleur}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Fiabilité des auteurs -->
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding ClairFiabilite}"
                                        Padding="10,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding DeplierCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <c:Icone Nom="Bouclier" Taille="14" Couleur="{Binding CouleurFiabilite}" />
                                        <Label Grid.Column="1" Style="{StaticResource TexteLegende}" FontFamily="JakartaSemiBold"
                                               TextColor="{StaticResource Texte}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Fiabilite}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding FiabiliteDetail}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <c:Icone Grid.Column="2" Nom="{Binding Chevron}" Taille="14" Couleur="{StaticResource Texte2}" />
                                    </Grid>
                                </Border>

                                <!-- Actions (UC15) -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding Ouverte}">
                                    <Label Text="{Binding Statut}" Style="{StaticResource TexteLegende}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="Valider" Style="{StaticResource BoutonSucces}" IsEnabled="{Binding PeutValider}"
                                                Command="{Binding ValiderCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Rejeter" Style="{StaticResource BoutonDanger}"
                                                Command="{Binding RejeterCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="Fusionner" Style="{StaticResource BoutonContour}" MinimumHeightRequest="46"
                                                Command="{Binding FusionnerCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Clôturer" Style="{StaticResource BoutonContour}" MinimumHeightRequest="46"
                                                Command="{Binding CloturerCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Button Text="Voir les signalements" Style="{StaticResource BoutonLien}"
                                            HorizontalOptions="Center"
                                            Command="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
