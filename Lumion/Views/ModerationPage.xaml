<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.ModerationPage"
             x:DataType="vm:ModerationViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="48,*" Padding="12,8,16,8" BackgroundColor="{StaticResource Blanc}">
            <Grid BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="Retour">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Retour" />
                </Grid.GestureRecognizers>
                <c:Icone Nom="ChevronGauche" />
            </Grid>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Modération" Style="{StaticResource TitrePage}" FontSize="24" />
                <Label Text="Vérifiez et validez les signalements de coupures" Style="{StaticResource SousTitrePage}" />
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="16,8" Spacing="10" BackgroundColor="{StaticResource Blanc}">
            <c:Choix Options="{Binding Onglets}" Valeurs="traiter|suspects" Change="OngletChange" Etire="True" />
            <Button Text="{Binding LibelleTri}" Style="{StaticResource BoutonSecondaire}" HorizontalOptions="Start"
                    Command="{Binding InverserTriCommand}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Cartes}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,64,32,0" Spacing="8">
                    <c:Icone Nom="Check" Taille="44" Couleur="{StaticResource Vert}" />
                    <Label Text="Aucune coupure à traiter" Style="{StaticResource TitreElement}" HorizontalTextAlignment="Center" />
                    <Label Text="La file de modération est vide pour cette catégorie." Style="{StaticResource Discret}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CarteModeration">
                    <Grid Padding="16,6">
                        <Border Style="{StaticResource Carte}" Padding="14,12">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding DeplierCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Border Style="{StaticResource Rond}" WidthRequest="48" HeightRequest="48"
                                            BackgroundColor="{Binding Couleur}" VerticalOptions="Start">
                                        <c:Icone Nom="Eclair" Couleur="{StaticResource Blanc}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Quartier}" Style="{StaticResource TitreElement}" FontSize="16" />
                                        <Label Text="{Binding Date}" Style="{StaticResource Discret}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <c:Icone Nom="Personnes" Taille="14" Couleur="{StaticResource Gris}" />
                                            <Label Text="{Binding Signalements}" FontSize="13" />
                                        </HorizontalStackLayout>
                                        <Border Style="{StaticResource Pastille}" BackgroundColor="{Binding ClairFiabilite}"
                                                HorizontalOptions="Start" Padding="8,3">
                                            <Label Text="{Binding Fiabilite}" TextColor="{Binding CouleurFiabilite}" FontSize="12"
                                                   FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <c:Icone Grid.Column="2" Nom="{Binding Chevron}" Taille="20" VerticalOptions="Start" />
                                </Grid>

                                <VerticalStackLayout Spacing="12" IsVisible="{Binding Ouverte}">
                                    <BoxView HeightRequest="1" Color="{StaticResource Bordure}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8"
                                          RowSpacing="8">
                                        <c:Icone Nom="Epingle" Taille="16" />
                                        <Label Grid.Column="1" Text="Quartier" Style="{StaticResource Discret}" />
                                        <Label Grid.Column="2" Text="{Binding Quartier}" Style="{StaticResource TitreElement}" FontSize="13" />
                                        <c:Icone Grid.Row="1" Nom="Horloge" Taille="16" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="Premiers signalements" Style="{StaticResource Discret}" />
                                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Premiers}" FontSize="13" />
                                        <c:Icone Grid.Row="2" Nom="Info" Taille="16" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="État" Style="{StaticResource Discret}" />
                                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding Statut}" FontSize="13" />
                                        <c:Icone Grid.Row="3" Nom="Bouclier" Taille="16" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="Fiabilité" Style="{StaticResource Discret}" />
                                        <Label Grid.Row="3" Grid.Column="2" Text="{Binding FiabiliteDetail}"
                                               TextColor="{Binding CouleurFiabilite}" FontFamily="OpenSansSemibold" FontSize="13" />
                                    </Grid>
                                    <Button Text="Voir les signalements et leurs auteurs" Style="{StaticResource BoutonLien}"
                                            HorizontalOptions="Start"
                                            Command="{Binding DetailCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <Button Text="Valider" BackgroundColor="{StaticResource Vert}" TextColor="{StaticResource Blanc}"
                                                IsEnabled="{Binding PeutValider}"
                                                Command="{Binding ValiderCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Rejeter" Style="{StaticResource BoutonDanger}"
                                                Command="{Binding RejeterCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Row="1" Text="Fusionner" Style="{StaticResource BoutonSecondaire}"
                                                Command="{Binding FusionnerCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Row="1" Grid.Column="1" Text="Clôturer" Style="{StaticResource BoutonSecondaire}"
                                                Command="{Binding CloturerCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationViewModel}}, x:DataType=vm:ModerationViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <c:BarreOnglets Grid.Row="3" Actif="profil" />
    </Grid>
</ContentPage>
