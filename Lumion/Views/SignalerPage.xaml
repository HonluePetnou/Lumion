<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Lumion.Controls"
             xmlns:vm="clr-namespace:Lumion.ViewModels"
             x:Class="Lumion.Views.SignalerPage"
             x:DataType="vm:SignalerViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:EnTete Titre="Signaler une coupure" Retour="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,16" Spacing="18">
                <!-- Quartier pré-rempli par le GPS (RG08), modifiable -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Bordure}"
                            StrokeThickness="1" Padding="12,9,14,9" HorizontalOptions="Center"
                            SemanticProperties.Description="Changer de quartier">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangerQuartierCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8">
                            <c:Icone Nom="Epingle" Taille="16" Couleur="{StaticResource AccentTexte}" />
                            <Label Text="{Binding NomQuartier}" Style="{StaticResource TexteElement}" FontFamily="JakartaBold"
                                   VerticalOptions="Center" />
                            <c:Icone Nom="ChevronBas" Taille="14" Couleur="{StaticResource Texte2}" />
                        </HorizontalStackLayout>
                    </Border>
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <c:Icone Nom="{Binding IconeGps}" Taille="14" Couleur="{Binding CouleurGps}" />
                        <Label Text="{Binding EtatGps}" Style="{StaticResource TexteLegende}" TextColor="{Binding CouleurGps}"
                               FontFamily="JakartaSemiBold" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding DetailGps}" Style="{StaticResource TexteLegende}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Un appui suffit -->
                <Grid WidthRequest="270" HeightRequest="270" HorizontalOptions="Center" SemanticProperties.Description="Envoyer : pas de courant ici">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EnvoyerCommand}" />
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="{StaticResource AccentHalo2}" />
                    <Ellipse Fill="{StaticResource AccentHalo}" Margin="24" />
                    <Border Margin="46" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{StaticResource Accent}">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Accent}" Opacity="0.5" Radius="30" Offset="0,12" />
                        </Border.Shadow>
                        <Grid>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center"
                                                 IsVisible="{Binding Pret}">
                                <c:Icone Nom="Eclair" Taille="46" Couleur="{StaticResource SurAccent}" />
                                <Label Text="Pas de courant" FontFamily="JakartaExtraBold" FontSize="18"
                                       TextColor="{StaticResource SurAccent}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <ActivityIndicator IsRunning="{Binding EnvoiEnCours}" IsVisible="{Binding EnvoiEnCours}"
                                               Color="{StaticResource SurAccent}" WidthRequest="40" HeightRequest="40" />
                        </Grid>
                    </Border>
                </Grid>
                <Label Text="Un appui suffit. Vos voisins confirment, et tout le quartier est prévenu."
                       Style="{StaticResource TexteSecondaire}" HorizontalTextAlignment="Center" Margin="12,0" />

                <!-- Précisions facultatives -->
                <Border Style="{StaticResource Carte}" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Depuis quand ?" Style="{StaticResource Surtitre}" />
                        <c:Choix Options="À l'instant|15 min|30 min|1 h" Valeurs="0|15|30|60" Selection="{Binding Depuis}"
                                 Etire="True" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <Label Text="Où observez-vous la coupure ?" Style="{StaticResource Surtitre}" />
                        <c:Choix Options="Chez moi|Ma rue|Le quartier" Valeurs="Domicile|Rue|Quartier"
                                 Change="EtendueChangee" Etire="True" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <Label Text="Un détail ? (facultatif)" Style="{StaticResource Surtitre}" />
                        <Border Style="{StaticResource Champ}" BackgroundColor="{StaticResource Surface2}" StrokeThickness="0" Padding="12,4">
                            <Grid RowDefinitions="*,Auto">
                                <Editor Text="{Binding Commentaire}" MaxLength="200" HeightRequest="76" AutoSize="Disabled"
                                        Placeholder="Ex. : plus de courant côté ancien camp, depuis 2 heures."
                                        SemanticProperties.Description="Commentaire facultatif" />
                                <Label Grid.Row="1" Text="{Binding Compteur}" Style="{StaticResource TexteLegende}"
                                       HorizontalOptions="End" Margin="0,0,0,6" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Hors ligne : le signalement attend le réseau (EF2.5) -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="24,6,24,18">
            <c:Icone Nom="HorsLigne" Taille="16" Couleur="{StaticResource Texte3}" VerticalOptions="Start" />
            <Label Grid.Column="1" Text="Hors connexion ? Le signalement partira tout seul dès le retour du réseau."
                   Style="{StaticResource TexteLegende}" TextColor="{StaticResource Texte3}" />
        </Grid>
    </Grid>
</ContentPage>
