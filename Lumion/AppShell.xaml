<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:v="clr-namespace:Lumion.Views"
       x:Class="Lumion.AppShell"
       FlyoutBehavior="Disabled">

    <!--
        Navigation plate, la carte en écran d'accueil. La barre visible est Controls/BarreOnglets :
        l'onglet Activité regroupe l'historique (activite) et les signalements de l'habitant (signalements).
    -->
    <TabBar>
        <ShellContent Title="Carte" Route="accueil" ContentTemplate="{DataTemplate v:AccueilPage}" />
        <ShellContent Title="Stats" Route="statistiques" ContentTemplate="{DataTemplate v:StatistiquesPage}" />
        <ShellContent Title="Activité" Route="activite" ContentTemplate="{DataTemplate v:ActivitePage}" />
        <ShellContent Title="Mes signalements" Route="signalements" ContentTemplate="{DataTemplate v:MesSignalementsPage}" />
        <ShellContent Title="Profil" Route="profil" ContentTemplate="{DataTemplate v:ProfilPage}" />
    </TabBar>

</Shell>
