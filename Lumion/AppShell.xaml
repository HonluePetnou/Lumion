<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:v="clr-namespace:Lumion.Views"
       x:Class="Lumion.AppShell"
       FlyoutBehavior="Disabled">

    <!-- Navigation plate : quatre onglets permanents, la carte en écran d'accueil. -->
    <TabBar>
        <ShellContent Title="Accueil" Icon="tab_accueil.png" Route="accueil"
                      ContentTemplate="{DataTemplate v:AccueilPage}" />
        <ShellContent Title="Statistiques" Icon="tab_stats.png" Route="statistiques"
                      ContentTemplate="{DataTemplate v:StatistiquesPage}" />
        <ShellContent Title="Signalements" Icon="tab_signalements.png" Route="signalements"
                      ContentTemplate="{DataTemplate v:MesSignalementsPage}" />
        <ShellContent Title="Profil" Icon="tab_profil.png" Route="profil"
                      ContentTemplate="{DataTemplate v:ProfilPage}" />
    </TabBar>

</Shell>
