<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Hiérarchie typographique limitée à quelques tailles, espacements sur une grille de 4. -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="TitrePage" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="SousTitrePage" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Gris}" />
    </Style>

    <Style x:Key="TitreSection" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="TitreElement" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="Discret" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Gris}" />
    </Style>

    <Style x:Key="Chiffre" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="Erreur" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Rouge}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <!-- La navigation passe par la barre du bas (Controls/BarreOnglets), identique sur toutes les plateformes. -->
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Blanc}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Blanc}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaireFonce}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource PrimaireFonce}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Encre}" />
    </Style>

    <!-- Cartes -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Blanc}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Pastille" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="Rond" TargetType="Border">
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Boutons : cibles tactiles d'au moins 48 dp. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource FondGris}" />
                            <Setter Property="TextColor" Value="{StaticResource GrisClair}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BackgroundColor" Value="{StaticResource FondGris}" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BoutonLien" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaireFonce}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="BoutonDanger" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BackgroundColor" Value="{StaticResource Rouge}" />
        <Setter Property="TextColor" Value="{StaticResource Blanc}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Champs de saisie -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GrisClair}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource GrisClair}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="TitleColor" Value="{StaticResource Gris}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="Champ" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Blanc}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,2" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primaire}" />
        <Setter Property="ThumbColor" Value="{StaticResource Blanc}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primaire}" />
    </Style>

</ResourceDictionary>
