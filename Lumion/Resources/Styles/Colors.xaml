<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Charte Lumion : ambre pour l'action, bleu nuit pour le texte. -->
    <Color x:Key="Primaire">#FDB022</Color>
    <Color x:Key="PrimaireFonce">#DC8A04</Color>
    <Color x:Key="PrimaireClair">#FFF4DB</Color>

    <Color x:Key="Encre">#0F1B3D</Color>
    <Color x:Key="Texte">#344054</Color>
    <Color x:Key="Gris">#667085</Color>
    <Color x:Key="GrisClair">#98A2B3</Color>
    <Color x:Key="Bordure">#E4E7EC</Color>
    <Color x:Key="Fond">#F6F7F9</Color>
    <Color x:Key="FondGris">#EEF0F4</Color>
    <Color x:Key="Blanc">#FFFFFF</Color>

    <!-- Statuts : toujours doublés d'une icône et d'un libellé (ENF6). -->
    <Color x:Key="Vert">#16A34A</Color>
    <Color x:Key="VertClair">#DCFCE7</Color>
    <Color x:Key="Orange">#F97316</Color>
    <Color x:Key="OrangeClair">#FFEDD5</Color>
    <Color x:Key="Rouge">#E11D48</Color>
    <Color x:Key="RougeClair">#FFE4E6</Color>
    <Color x:Key="Bleu">#2563EB</Color>
    <Color x:Key="BleuClair">#DBEAFE</Color>
    <Color x:Key="Violet">#7C3AED</Color>
    <Color x:Key="VioletClair">#EDE9FE</Color>

</ResourceDictionary>
